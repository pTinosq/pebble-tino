# ---- Copy this file to `.env` and fill in real values ----
# `.env` is gitignored. NEVER commit real keys or tokens.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for the tool-calling assistant. gemini-3-flash-preview does clean tool
# calls via OpenRouter; gemini-2.5-flash and gpt-5.4-mini leak tool calls as
# text — avoid those for tools.
MODEL=google/gemini-3-flash-preview

# HTTP
PORT=8080

# Shared secret the watch sends in the `x-assistant-token` header.
# Pick any random string; set the SAME value in the watch app config.
# Leave blank to disable the auth check (not recommended for a public URL).
ASSISTANT_TOKEN=

# ---- MCP servers (all OAuth) ----
# Notion: run `just setup-notion` (no keys needed — dynamic registration).
# Tokens are stored in apps/server/.notion-tokens.json (gitignored).

# Slack: create a Slack app (api.slack.com/apps), add redirect
# http://localhost:8789/callback + User Token Scopes, then run `just setup-slack`.
# Tokens stored in apps/server/.slack-tokens.json (gitignored).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional: override scopes (must match the app's User Token Scopes)
# SLACK_SCOPES="search:read.public channels:history channels:read users:read chat:write"

# (Google Workspace MCP was removed — Developer-Preview-gated, blocks personal Gmail.)
