# ---- Copy this file to `.env` and fill in real values ----
# `.env` is gitignored. NEVER commit real keys or tokens.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for the tool-calling assistant.
# NOTE: Gemini 3 models (e.g. google/gemini-3.1-flash-lite) currently hit a
# "missing thought_signature" error with tool-calling via OpenRouter, so this
# tool-using backend defaults to 2.5-flash. Switch once that's fixed upstream.
MODEL=google/gemini-2.5-flash

# HTTP
PORT=8080

# Shared secret the watch sends in the `x-assistant-token` header.
# Pick any random string; set the SAME value in the watch app config.
# Leave blank to disable the auth check (not recommended for a public URL).
ASSISTANT_TOKEN=

# ---- MCP servers (official remote endpoints) ----
# Tokens are OAuth access tokens obtained per the README. They are short-lived
# (Notion ~1h) — see src/oauth.ts for refresh. A server with no URL is skipped.
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_MCP_TOKEN=

GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=

GCAL_MCP_URL=
GCAL_MCP_TOKEN=
