# ---- Copy this file to `.env` and fill in real values ----
# `.env` is gitignored. NEVER commit real keys or tokens.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for the tool-calling assistant. gemini-3-flash-preview does clean tool
# calls via OpenRouter; gemini-2.5-flash and gpt-5.4-mini leak tool calls as
# text — avoid those for tools.
MODEL=google/gemini-3-flash-preview

# HTTP
PORT=8080

# Shared secret the watch sends in the `x-assistant-token` header.
# Pick any random string; set the SAME value in the watch app config.
# Leave blank to disable the auth check (not recommended for a public URL).
ASSISTANT_TOKEN=

# ---- MCP servers (all OAuth) ----
# Notion: run `just setup-notion` (no keys needed — dynamic registration).
# Tokens are stored in apps/server/.notion-tokens.json (gitignored).

# Google (Calendar/Gmail): create an OAuth "Web application" client in Google
# Cloud (redirect URI http://localhost:8788/callback), then run `just setup-google`.
# Tokens stored in apps/server/.google-tokens.json (gitignored).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides (defaults are the official endpoints / calendar-only scopes):
# CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# GOOGLE_SCOPES="https://www.googleapis.com/auth/calendar.events.readonly ..."
